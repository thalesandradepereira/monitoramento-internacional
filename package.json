{
  "name": "monitoramento-internacional",
  "version": "1.1.4",
  "description": "Resumo diário das principais notícias internacionais das últimas 24h, por e-mail",
  "private": true,
  "scripts": {
    "once": "tsx src/run.ts",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts tests/**/*.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "p-limit": "^7.3.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^7.0.12",
    "google-news-url-decoder": "^1.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
