# === IA (Gemini Developer API) ===
# Chave do Google AI Studio. O nível gratuito tem limites de uso próprios.
GEMINI_API_KEY=
# Modelo de maior qualidade apenas na seleção/resumo editorial.
GEMINI_MODEL_SUMMARY=gemini-3.6-flash
# Modelo econômico para as etapas de maior volume.
GEMINI_MODEL_TRIAGE=gemini-3.5-flash-lite
GEMINI_MODEL_TRANSLATION=gemini-3.5-flash-lite
# Compatibilidade: GEMINI_MODEL, se definido, substitui os três padrões acima.
# GEMINI_MODEL=
GEMINI_TIMEOUT_MS=120000

# === Para quem enviar o resumo ===
# (Valor REAL fica no GitHub Secret DEST_EMAIL, não aqui. Isto é só exemplo.)
# Vários destinos: separe por vírgula. Ex.: owner.private@example.test, owner.private@example.test
DEST_EMAIL=owner.private@example.test

# === Como enviar o e-mail (SMTP) ===
# Opção mais fácil: Gmail com "Senha de app" (não é sua senha normal).
#   1. Ative a verificação em 2 etapas na sua conta Google
#   2. Gere uma "Senha de app" em https://myaccount.google.com/apppasswords
#   3. Use seu Gmail em SMTP_USER e a senha de app (16 letras) em SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=owner.private@example.test
SMTP_PASS=senha-de-app-de-16-letras
# Nome/remetente que aparece no e-mail
FROM_NAME=Resumo IA

# === Agendamento ===
# Horário diário local: 02:00 em Brasília (America/Sao_Paulo).
# O GitHub Actions usa 02:17 com timezone explícito para reduzir atrasos de fila.
CRON_EXPR=0 2 * * *
TIMEZONE=America/Sao_Paulo
# Caminho do registro persistente de idempotência diária (sem dados pessoais).
DAILY_EXECUTION_LOG_PATH=state/daily-executions.json
# Execuções manuais devem usar DRY_RUN=true por padrão; agendadas usam envio real.
DRY_RUN=true
EXECUTION_MODE=manual

# Quantos tópicos no máximo
MAX_TOPICOS=10
# Janela de notícias (horas)
JANELA_HORAS=24
# Quantidade mínima de fontes RSS que precisam responder em cada execução
MIN_SUCCESSFUL_SOURCES=7

# === Descadastro automático (opcional) ===
# URL do Cloudflare Worker de descadastro (após deploy)
UNSUBSCRIBE_WORKER_URL=https://resumo-ia-unsub.SEU-USUARIO.workers.dev
# Chave secreta compartilhada (HMAC) — gere uma aleatória e use a mesma no Worker
UNSUBSCRIBE_SECRET=

# === Destinatários privados no Cloudflare D1 ===
RECIPIENTS_SOURCE=d1
RECIPIENTS_API_URL=https://monitoramento-internacional-unsub.SEU-USUARIO.workers.dev/internal/recipients
RECIPIENTS_API_TOKEN=
RECIPIENTS_API_TIMEOUT_MS=5000
RECIPIENTS_MAX_RECIPIENTS=500
